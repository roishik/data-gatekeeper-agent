# Copy this file to .env for local development. In prod (Cloud Run),
# every one of these is instead injected as an env var from Secret
# Manager -- app/config.py reads os.environ either way and never knows
# the difference. See docs/RUNBOOK.md for the full deploy sequence.
#
# NOTHING in this file is a real secret. Every value below is a
# placeholder -- fill in your own.

# ── AgentMail ────────────────────────────────────────────────────────────
# NOTE: AgentMail's own SDK/docs examples name this AGENTMAIL_WEBHOOK_SECRET
# and the key itself is commonly saved as something like
# agent_mail_api_key in ad-hoc notes -- this project's code always reads
# the exact names below (uppercase, no extra underscore in "AGENTMAIL").
# If your local .env has the key under a different name, rename it (or
# add a second line with this name) -- app/config.py does not fall back
# to alternate spellings for this one.
AGENTMAIL_API_KEY=
# Starts with "whsec_" -- from `client.webhooks.get(webhook_id=...)` or
# the AgentMail console when you create the webhook endpoint.
AGENTMAIL_WEBHOOK_SECRET=
# The inbox this service reads from, e.g. roi.shikler@agentmail.to's
# inbox id (not the email address itself -- AgentMail inboxes have a
# separate id, see the console or `agentmail inboxes list`).
AGENTMAIL_INBOX_ID=
# The gatekeeper's own inbox address -- used ONLY to reject inbound mail
# that claims to be from this address itself (loop prevention), never to
# authenticate anything. Example: roi.shikler@agentmail.to
GATEKEEPER_INBOX_ADDRESS=

# Exact-match sender allowlist, comma-separated. Display names are
# ignored -- only the address itself is compared. This is Instinct's
# sending address(es), never a domain or wildcard.
ALLOWED_SENDERS=

# Who gets BCC'd on every outbound reply -- your own address, the human
# audit-log copy.
OWNER_EMAIL=

# Webhook replay-window tolerance, seconds. 300 matches the Standard
# Webhooks spec's own recommended default; leave it unless you have a
# specific reason to widen or narrow it.
WEBHOOK_TOLERANCE_SECONDS=300

# ── Rate limiting ─────────────────────────────────────────────────────────
MAX_REQUESTS_PER_DAY=20

# ── Anthropic (Layer 2's quarantined reader LLM only) ───────────────────
ANTHROPIC_API_KEY=
# Pinned, dated snapshot on purpose -- a model swap should be a
# deliberate, tested change, not a silent float to "latest".
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Policy (Layer 3) ─────────────────────────────────────────────────────
# Comma-separated. A gmail.search query containing ANY of these (case-
# insensitive substring match) is refused outright. Leave unset to use
# the built-in default list (see app/config.py) -- only set this if you
# want to add to or replace it.
# SENSITIVE_QUERY_TERMS=otp,verification code,password reset,2fa,security alert,bank account,credit card

# ── Google (Layer 4: Gmail; also used by the Sheets-backed audit log /
#    state store in prod) ───────────────────────────────────────────────
# From the Desktop-app OAuth client in Google Cloud Console, project
# data-gatekeeper-roishik. See scripts/google_auth.py for how the
# refresh token below gets minted once, by hand -- never inside this
# service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_GMAIL_USER=me

# ── Reply guard (Layer 5) ────────────────────────────────────────────────
REPLY_MAX_CHARS=4000

# ── Audit log ─────────────────────────────────────────────────────────────
# "jsonl" (default) for local/dev -- writes to AUDIT_LOG_PATH, no
# credentials needed. "sheets" for prod.
AUDIT_LOG_BACKEND=jsonl
AUDIT_LOG_PATH=./data/audit_log.jsonl
# Only used when AUDIT_LOG_BACKEND=sheets. Leave unset on first prod run
# -- a spreadsheet is created automatically and its id is logged loudly;
# copy that id here (and into Secret Manager) so every later run reuses
# the same spreadsheet instead of creating a new one each restart.
GOOGLE_SHEETS_LOG_SPREADSHEET_ID=

# "memory" (default) for local/dev -- resets on restart, zero setup.
# "sheets" for prod.
STATE_STORE_BACKEND=memory
# Only used when STATE_STORE_BACKEND=sheets. Same "leave unset on first
# run, then pin it" pattern as the audit log above.
GOOGLE_SHEETS_STATE_SPREADSHEET_ID=

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# Cloud Run injects PORT itself; 8080 is both its default and this
# service's own fallback for a local run.
PORT=8080
